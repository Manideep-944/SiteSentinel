# SiteSentinel Server Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sitesentinel
JWT_SECRET=sitesentinel_jwt_secret_dev_key_change_in_production_2026
CLIENT_URL=http://localhost:5173
MONITOR_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_MS=10000

# Optional Email Alerts (SMTP)
# Leave empty if you do not wish to send actual email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SiteSentinel Alerts" <no-reply@sitesentinel.local>
SMTP_SECURE=false
